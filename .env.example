# =============================================================================
# financeOS — variáveis de ambiente
# =============================================================================
#
# Em produção, TODAS as envs core abaixo são preenchidas automaticamente pelo
# wizard /setup (Vercel API). Você NÃO precisa editar este arquivo.
#
# Para dev local, copie para .env e preencha apenas as VITE_* — devem apontar
# para um projeto Supabase que já passou pelo wizard (com migrations aplicadas
# e app_settings populado).
# =============================================================================


# Frontend / Vercel — necessárias pro app subir
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side (API Routes Vercel) — wizard injeta automaticamente em produção.
# Em dev local, só preencha se for testar /api/* localmente (vercel dev).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cripto de app_settings — wizard gera (32 bytes hex). Mesma observação acima.
# ⚠️ NUNCA delete esta env do Vercel após o setup; perdê-la torna todas as
# credenciais em app_settings ilegíveis.
CRYPTO_KEY=

# As credenciais de aplicação (OpenAI, Gmail OAuth, CRON_SECRET, APP_URL)
# vivem em public.app_settings (criptografadas). Configure via /setup ou
# em /configuracoes → IA e Gmail (owner-only).
